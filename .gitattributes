# Normalize text files to LF in the repo and on checkout.
# Prevents whole-file CRLF/LF diffs when editing on Windows / WSL.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
