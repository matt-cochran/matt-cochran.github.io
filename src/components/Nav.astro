---
const navLinks = [
  { href: '/#products', label: 'Products' },
  { href: '/#praxec', label: 'Governed AI' },
  { href: '/#tflo', label: 'Runtimes' },
  { href: '/product-workshop/', label: 'Methodology' },
  { href: '/scale-readiness/', label: 'Startup Advisory' },
];
---

<nav class="site-nav" aria-label="Main">
  <div class="shell nav-inner">
    <a href="/" class="wordmark" aria-label="Matthew Cochran, home"><strong>Matthew Cochran</strong><span>Product &amp; Engineering Dossier</span></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links"><span></span><span></span><span></span><span class="sr-only">Toggle navigation</span></button>
    <div id="nav-links" class="nav-links">
      {navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      <a class="nav-resume" href="/resume/">View résumé <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.querySelector<HTMLElement>('.nav-links');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    links?.toggleAttribute('data-open', !open);
  });
  links?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    toggle?.setAttribute('aria-expanded', 'false');
    links.removeAttribute('data-open');
  }));
</script>
