---
interface Props { eyebrow: string; title: string; description: string; aside?: string; }
const { eyebrow, title, description, aside } = Astro.props;
---
<header class="page-hero dossier-grid">
  <div class="shell page-hero-grid reveal">
    <div><p class="kicker">{eyebrow}</p><h1>{title}</h1></div>
    <div class="page-hero-copy"><p>{description}</p>{aside && <span>{aside}</span>}</div>
  </div>
</header>
