---
import BaseLayout from '../layouts/BaseLayout.astro';
const roles = [{"company": "MC Product Labs", "role": "Product Development", "years": "September 2026 - Present", "bullets": ["Developing software tools and preparing selected commercial products for production release."]}, {"company": "OutboundLabs", "role": "Technical Co-Founder", "years": "2024 - Present", "bullets": ["Side project alongside employment through January 2026; transitioned to full-time work after Distributed Spectrum.", "Designed and developed an agentic CRM initiative spanning outreach, customer workflows, and support using Rust, C#, TypeScript, and React.", "Designed licensing, distributed-workflow, and AI development capabilities for internal testing."]}, {"company": "Distributed Spectrum", "role": "Staff Engineer, Full Stack", "years": "May 2025 - January 2026", "bullets": ["Led SensorHQ re-architecture in Rust and React for AI-enhanced radio-spectrum analysis, integrating active learning and embedded Jupyter capabilities.", "Reduced model training time from five hours to five minutes through active-learning integration.", "Built an MCP pipeline generating cross-framework UI components from Figma; mentored engineers in Rust and component architecture."]}, {"company": "Qrypt", "role": "Staff Software Engineer, Scalability", "years": "April 2023 - January 2025", "bullets": ["Designed and implemented architecture for quantum-secure encryption services using Azure, Rust, Go, Kubernetes, and Terraform.", "Reduced cloud costs by 80% using KEDA-based dynamic scaling, spot instances, and serverless infrastructure.", "Migrated high-load Python services to Rust and Go, using Dapr microservice architecture to improve compute efficiency.", "Automated delivery pipelines and redesigned disaster recovery, achieving full system recovery in under four hours."]}, {"company": "TruthShield", "role": "Founder and CTO", "years": "January 2022 - April 2023", "bullets": ["Developed a SaaS engineering acceleration framework and AI-driven engineering analytics using GCP, C#, React, Python, Kubernetes, and PostgreSQL."]}, {"company": "artnet", "role": "Chief Technology Officer", "years": "March 2018 - February 2022", "bullets": ["Owned modernization of a decades-old monolithic platform, actively designing, planning, managing, and helping execute the transition toward cloud architecture.", "Led engineering collaboration with MediaAgility on a phased on-premises migration to GCP, separating infrastructure migration from broader application modernization.", "Used GCP, AWS, C#, Python, Kubernetes, and Terraform; reduced infrastructure costs by more than $2 million annually through optimization and vendor management.", "Introduced CI/CD and deployment automation, reducing deployment times from weeks to minutes."]}, {"company": "artnet", "role": "Chief Architect and SVP Engineering", "years": "March 2017 - March 2018", "bullets": ["Redesigned legacy architecture with event-driven microservices and containerization; led improvements to deployment automation."]}, {"company": "Medidata Solutions", "role": "Senior Manager, Software Development", "years": "December 2013 - February 2017", "bullets": ["Architected enterprise cloud software and led engineering teams using AWS, Python, C#, SQL Server, and CI/CD; improved performance, reducing latency by 45%."]}];
const skills = [
 ['AI and developer tools', 'LLM integration, agent workflows, MCP servers, tool permissions, human approval controls, deterministic verification, Playwright, CLI development.'],
 ['Software development', 'Rust, Go, TypeScript, Python, C#, React; APIs, distributed systems, Git worktrees, CI/CD.'],
 ['Cloud and infrastructure', 'AWS, Azure, Google Cloud, Kubernetes, Terraform, Ansible, KEDA, Dapr.'],
 ['Data and operations', 'PostgreSQL, MongoDB, SQL Server, Datadog, delivery automation, disaster recovery.'],
];
---
<BaseLayout title="Matthew Cochran — Staff Software Engineer Résumé" description="Hands-on software architect and Staff Software Engineer. AI systems, developer tools, distributed systems, and product architecture. Download either targeted résumé.">
 <header class="resume-approved-hero section-enter"><div class="shell resume-approved-grid"><div>
  <div class="stamp-row"><span class="status-stamp">Staff Software Engineer</span><span class="status-stamp steel-stamp">Hands-on Software Architect</span></div>
  <h1>Dependable systems.<br /><em>Hands-on engineering.</em></h1>
  <p>Hands-on software architect with Staff Engineer experience in AI agent workflows, developer tools, and distributed services. Professional work includes Rust/React product development, MCP automation, and hands-on CTO leadership. Seeking a full-time individual-contributor role.</p>
 </div><aside><p class="kicker">Download a résumé</p><div class="resume-downloads">
  <a href="/resume/matthew-cochran-ai-systems-developer-tools.pdf" download>AI Systems &amp; Developer Tools <span aria-hidden="true">↓</span></a>
  <p>For agent workflows, developer platforms, and AI engineering roles.</p>
  <a href="/resume/matthew-cochran-distributed-systems-product-architecture.pdf" download>Distributed Systems &amp; Product Architecture <span aria-hidden="true">↓</span></a>
  <p>For cloud services, platform modernization, and software architecture roles.</p>
 </div><div><a href="mailto:matthew@cochranweb.com">matthew@cochranweb.com</a><a href="tel:+16469371654">646-937-1654</a><p>Valley Stream, NY / Remote</p><a href="https://www.linkedin.com/in/matthew-c-1a02b119/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://github.com/matt-cochran" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></aside></div></header>
 <section class="values-band resume-skills"><div class="shell values-grid">{skills.map(([title, copy], i) => <article><span>0{i+1}</span><h3>{title}</h3><p>{copy}</p></article>)}</div></section>
 <section id="open-source" class="section shell resume-section"><header class="section-heading"><div><p class="kicker">Selected open source</p><h2>Tools I build and use.</h2></div><p>Recently open-sourced and actively used across my own projects.</p></header>
  <div class="outcomes resume-projects"><article class="outcome"><p class="eyebrow">Junior Agent</p><h3>AI coding task delegation</h3><p>A CLI for scoped coding tasks using explicit acceptance criteria, isolated Git worktrees, independent checks, and bounded repair attempts. Reviewable handoffs report changes, check results, model usage, and unresolved work for manager review.</p><p>Integrates Praxec MCP/CLI tooling for critical-path planning, House of Quality analysis, and failure-mode assessment.</p><a href="https://junioragent.dev" target="_blank" rel="noopener noreferrer">Junior Agent ↗</a></article>
  <article class="outcome"><p class="eyebrow">Jevitate</p><h3>Autonomous browser testing</h3><p>A TypeScript CLI and MCP server for browser exploration, reproducible defect capture, regression testing, and replay-based fix verification. Separates model-directed exploration from deterministic browser checks, with CI reporting, authorized-origin controls, and execution limits.</p><a href="https://jevitate.com" target="_blank" rel="noopener noreferrer">Jevitate ↗</a></article>
  <article class="outcome"><p class="eyebrow">opv / 1password-vault</p><h3>Secrets delivery and DevOps tooling</h3><p>An open-source Rust CLI connecting 1Password-managed secrets to application runtimes and CI. Supports Fly.io, Azure Key Vault and Container Apps, Kubernetes, External Secrets Operator, and GitHub Actions.</p><p>Typed validation, explicit plan-and-sync workflows, deployment and pruning controls, and structured JSON reporting support automation and AI coding assistants. Uses redacting and zeroizing types and passes values through stdin or child-process environments.</p><a href="https://github.com/matt-cochran/1password-vault" target="_blank" rel="noopener noreferrer">View opv on GitHub ↗</a></article></div>
 </section>
 <section class="section shell resume-section"><header class="section-heading"><div><p class="kicker">Experience</p><h2>Professional history.</h2></div></header>
  <div class="resume-timeline">{roles.map(item => <article><div class="role-meta"><span>{item.years}</span></div><div class="role-title"><h3>{item.role}</h3><p>{item.company}</p></div><ul class="role-copy">{item.bullets.map(bullet => <li>{bullet}</li>)}</ul></article>)}</div>
  <p class="resume-evidence">External evidence: <a href="https://www.persistent.com/client-success/artnet-increases-efficiency-by-280x-as-they-move-to-google-cloud/" target="_blank" rel="noopener noreferrer">Persistent / MediaAgility artnet cloud-migration case study ↗</a></p>
  <div class="resume-earlier"><h3>Earlier experience</h3><p>Shutterstock · Manager, Software Development · 2012–2013</p><p>Vertical Capital Investment Advisors · Systems Architect / Technical Lead · 2011–2012</p></div>
 </section>
</BaseLayout>
