---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const expertise = [
  ['Product leadership','Discovery, strategy, roadmap governance, customer-centered product practices, and commercial prioritization.'],
  ['Engineering leadership','Organization design, team development, architecture governance, quality, DevOps, and operational accountability.'],
  ['Program execution','Critical-path planning, dependency management, portfolio governance, risk, cost, and delivery control.'],
  ['AI engineering','Governed agentic systems, MCP tools, cognitive architectures, retrieval and context design, evaluation, approval, and auditability.'],
];
const roles = [
  { years:'2023–Present', role:'Co-Founder', company:'OutboundLabs', location:'Remote', copy:'Scalable software architecture, AI/LLM engineering, cloud platforms, and engineering leadership for emerging and growing products.' },
  { years:'2022–2023', role:'Founder, CTO', company:'TruthShield', location:'New York', copy:'Built tools, training, and services to strengthen software manufacturing, reduce failure, improve delivery efficiency, and align technical and non-technical stakeholders.' },
  { years:'2018–2022', role:'Chief Technology Officer', company:'Artnet', location:'New York', copy:'Ran product R&D, engineering, quality, IT, and project-management practices for a publicly traded company. Set product, technical, organizational, staffing, budget, vendor, and modernization strategy while remaining hands-on in architecture, project design, and team coaching.' },
  { years:'2017–2018', role:'Chief Architect, SVP Engineering', company:'Artnet', location:'New York', copy:'Led architecture, technical product ownership, requirements, delivery, quality, and continuous improvement. Brought critical technical decision-making in-house and established executable specifications and test-driven practices.' },
  { years:'2014–2017', role:'Senior Manager, Development', company:'Medidata', location:'New York', copy:'Hands-on architect and technical/process leader across multiple teams and products at a billion-dollar enterprise. Represented flagship products in architecture governance, defined capability roadmaps, designed brownfield modernization, repaired underperforming products, staffed teams, and mentored execution.' },
  { years:'2013', role:'Senior Software Engineer / Systems Architect', company:'PetCareRx', location:'New York', copy:'Architected and built a new flagship site, personalization engine, and content platform; introduced automated CI/CD and quality gates; trained developers and directed team output.' },
  { years:'2012–2013', role:'Manager of Software Development', company:'Shutterstock', location:'New York', copy:'Built and managed the integration and internal-systems team, standardized development and maintenance processes, led new projects, and improved performance and total cost of ownership.' },
  { years:'2011–2012', role:'Senior Software Architect / Analyst', company:'Vertical Capital Investment Advisors', location:'New York', copy:'Analyzed high-risk legacy systems, designed service-bus and throughput improvements, created multi-phase modernization plans, and presented time, cost, and risk options to senior leadership.' },
  { years:'2008–2011', role:'Senior Software Architect / Team Lead', company:'Business Intelligence Associates', location:'New York', copy:'Built and led product engineering for digital forensics and e-discovery. Architected distributed evidence-processing systems, increased throughput, reduced processing errors, and delivered defensible remote forensic collection.' },
  { years:'2005–2008', role:'Software Developer', company:'Debevoise & Plimpton', location:'New York', copy:'Led analysis and development of multi-tier systems, wrote functional and technical specifications, and mentored the team in architecture, performance, concurrency, testing, and data structures.' },
  { years:'2001–2005', role:'Manager of Web Development', company:'Boardroom', location:'Connecticut', copy:'Led the product and technology work that brought an analog business to the web, including content, workflow, asset, commerce, and marketing systems; launched an online initiative producing more than $1M in first-year revenue.' },
];
---
<BaseLayout title="Matthew Cochran — Résumé" description="Full professional history for Matthew Cochran: hands-on CTO, product and engineering leader, architect, and governed-AI engineering specialist.">
  <PageHeader eyebrow="Leadership résumé / 25+ years" title="Matthew Cochran" description="Hands-on product and engineering executive. CTO, founder, architect, team builder, program leader, and software developer across public companies, billion-dollar enterprise platforms, and startups." aside="New York · Remote · matthew@cochranweb.com" />
  <section class="resume-summary shell reveal">
    <div><p class="kicker">Executive profile</p><h2>Player-coach leadership for products and systems that have to work.</h2></div>
    <div><p>Leads the full operating system around product development: discovery and strategy, program structure, engineering organizations, architecture, quality, delivery, and operations. Specialized in artificial-intelligence engineering with an emphasis on deterministic execution, model/tool boundaries, human approval, auditability, and production reliability.</p><div class="resume-links"><a class="button primary" href="mailto:matthew@cochranweb.com">Contact Matthew →</a><a class="text-link" href="https://www.linkedin.com/in/matthew-cochran-1a02b119/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
  </section>
  <section class="values-band"><div class="shell values-grid">{expertise.map(([title,copy],i)=><article><span>0{i+1}</span><h3>{title}</h3><p>{copy}</p></article>)}</div></section>
  <section class="section shell">
    <header class="section-heading"><div><p class="kicker">Experience</p><h2>Professional history.</h2></div><p>A progression from hands-on development through architecture, team leadership, product operations, and executive accountability—without leaving implementation behind.</p></header>
    <div class="resume-timeline">{roles.map((item)=><article><div class="role-meta"><span>{item.years}</span><small>{item.location}</small></div><div class="role-title"><h3>{item.role}</h3><p>{item.company}</p></div><p class="role-copy">{item.copy}</p></article>)}</div>
  </section>
  <section class="engagement shell"><div><p class="kicker">Current evidence</p><h2>See what is being built now.</h2></div><div><p>The product portfolio and open-source families show the present-day application of this experience.</p><div class="engagement-links"><a class="button primary" href="/#products">Explore products →</a><a class="text-link" href="/product-workshop/">Product Workshop</a></div></div></section>
</BaseLayout>
