---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ScaleReadinessSnapshot from '../components/ScaleReadinessSnapshot.astro';
---
<BaseLayout title="Scale Readiness Snapshot — Matthew Cochran" description="A short structured assessment to determine whether a Scale Readiness Diagnostic is appropriate for your startup.">
  <PageHeader eyebrow="Startup engagements / Readiness snapshot" title="Is this the right intervention, right now?" description="A short, structured assessment of company stage, engineering scale, hiring plans, scaling friction, decision authority, and timing." aside="Approximately three minutes · Fit before a call" />
  <section class="snapshot-shell shell">
    <aside><p class="kicker">What happens next</p><ol><li><span>01</span>Answer one question at a time.</li><li><span>02</span>Receive an immediate fit result.</li><li><span>03</span>If the fit is clear, schedule a short conversation.</li></ol><p>Your responses are used only to determine fit and are not shared externally.</p></aside>
    <div class="snapshot-panel"><ScaleReadinessSnapshot /></div>
  </section>
</BaseLayout>
