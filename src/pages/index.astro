---
import BaseLayout from '../layouts/BaseLayout.astro';

const products = [
  {
    name: 'Attestrack',
    type: 'Customer product · open-source core',
    status: 'Public repository',
    description: 'First-party, server-side analytics designed to run in infrastructure the customer controls. Attestrue is a separate commercial extension.',
    evidence: ['Customer-controlled deployment', 'Open-source core', 'Separate commercial extension'],
    href: 'https://github.com/matt-cochran-products/attestrack',
    cta: 'Inspect repository',
    featured: true,
  },
  {
    name: 'Licenz',
    type: 'Developer infrastructure',
    status: 'Published on crates.io',
    description: 'Offline-first software-license verification for Rust, built around signed licenses, hardware binding, and an explicit threat model.',
    evidence: ['Offline verification', 'Rust crate', 'Documented threat model'],
    href: 'https://github.com/matt-cochran-products/licenz',
    cta: 'Read the source',
    featured: true,
  },
  {
    name: 'SureShift',
    type: 'SaaS readiness',
    status: 'Preview',
    description: 'A read-only product-readiness scanner for teams evaluating architecture, delivery, and recovery risk before they scale.',
    evidence: ['Read-only assessment', 'No installed agent', 'Decision-oriented output'],
    href: 'https://github.com/matt-cochran/sureshift',
    cta: 'Inspect repository',
  },
  {
    name: 'Synapate',
    type: 'Emerging product',
    status: 'Coming soon',
    description: 'An emerging product in the Matthew Cochran Products portfolio. Public details will follow as the product is ready for evaluation.',
    evidence: ['Status stated plainly', 'No premature claims'],
    href: 'https://github.com/matt-cochran-products',
    cta: 'Follow the organization',
  },
  {
    name: 'FrontRails',
    type: 'Praxec capability pack',
    status: 'Open-source work',
    description: 'A Praxec pack exposing governed product and engineering capabilities, including IntentOS and StructureOS.',
    evidence: ['Governed capabilities', 'Part of Praxec', 'Public source'],
    href: 'https://github.com/praxec',
    cta: 'Explore Praxec',
  },
  {
    name: 'Sound Playground',
    type: 'Local-first application',
    status: 'Public releases',
    description: 'A product exploration in local, privacy-conscious audio experiences for children.',
    evidence: ['Local-first direction', 'Public release repository'],
    href: 'https://github.com/matt-cochran-products',
    cta: 'View product organization',
  },
];

const outcomes = [
  {
    eyebrow: 'Public-company CTO leadership',
    title: 'Infrastructure modernization under active pressure',
    copy: 'Led the migration and consolidation of more than 600 virtual servers to Google Cloud with Infrastructure as Code, zero downtime, and a tested disaster-recovery foundation.',
    link: 'https://www.persistent.com/client-success/artnet-increases-efficiency-by-280x-as-they-move-to-google-cloud/',
  },
  {
    eyebrow: 'Billion-dollar enterprise · Medidata',
    title: 'Flagship-product architecture and portfolio repair',
    copy: 'Architected and repaired flagship products and led technical turnarounds for some of the weakest products in the portfolio—work requiring product judgment, delivery discipline, and hands-on technical depth.',
  },
  {
    eyebrow: 'Program and delivery governance',
    title: 'Critical-path discipline for consequential work',
    copy: 'Applies formal project planning, including CPM, to expose dependencies, sequence work, and control delivery risk—and builds tools that bring the same discipline to agentic coding.',
  },
];
---

<BaseLayout
  title="Matthew Cochran — Product Builder, Engineering Leader & AI Systems Specialist"
  description="Products, open-source systems, and leadership work by Matthew Cochran: a hands-on CTO and product-engineering leader specializing in dependable governed AI."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-layout">
      <div class="hero-copy reveal">
        <p class="kicker">Product &amp; engineering dossier <span>New York / Remote</span></p>
        <h1 id="hero-title">Governed AI systems <em>engineered</em> for dependability.</h1>
        <p class="hero-lede">Senior operator with 25+ years across product, project, and technical leadership.</p>
        <p class="hero-context">Former CTO of publicly traded Artnet and Founder/CTO at TruthShield. Specializing in production-oriented governed AI: deterministic execution, cognitive architectures, and policy-gated controls. I personally ship software while leading technical organizations and product turnarounds.</p>
        <div class="hero-actions">
          <a class="button primary" href="#products">Explore products</a>
          <a class="hero-text-cta" href="/resume/">View résumé <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="hero-profile reveal delay-1" aria-label="Profile summary">
        <div class="portrait-frame"><img src="/assets/images/MC-headshot.png" alt="Matthew Cochran" /></div>
        <dl class="profile-facts"><div><dt>Location</dt><dd>New York, NY / Remote</dd></div><div><dt>Current work</dt><dd>Praxec AI execution kernel &amp; CPM-driven agentic workflows</dd></div></dl>
      </aside>
    </div>
  </section>

  <section class="operating-band" aria-label="Operating disciplines">
    <div class="shell operating-grid">
      <article><span>01 / Product Discovery</span><h2>Governed Strategy</h2><p>Validating ICP resonance and AI readiness through falsification-based discovery. Ensuring commercial viability before committing capital to implementation.</p></article>
      <article><span>02 / Project Execution</span><h2>Agentic Flow</h2><p>Deploying Critical Path Method to orchestrate agentic coding workflows, expose dependencies, and keep consequential engineering work steerable.</p></article>
      <article><span>03 / Technical Implementation</span><h2>Safety Boundaries</h2><p>Personally shipping Rust/WASM execution kernels with durable policy gates, human approval, and verifiable audit trails.</p></article>
    </div>
  </section>

  <section id="products" class="section shell" aria-labelledby="products-title">
    <header class="section-heading reveal">
      <div><p class="kicker">Solutions for SaaS Privacy, Security &amp; Release Governance</p><h2 id="products-title">Product Catalog</h2></div>
      <p>Customer-facing products, developer infrastructure, and emerging work—each labeled by what is available today, with a direct path to evidence.</p>
    </header>
    <div class="product-grid">
      {products.map((product, index) => (
        <article class:list={['product-card', { featured: product.featured }, 'reveal']} style={`--order:${index}`}>
          <div class="card-meta"><span>{product.type}</span><strong>{product.status}</strong></div>
          <h3>{product.name}</h3>
          <p>{product.description}</p>
          <ul class="evidence-list">{product.evidence.map((item) => <li>{item}</li>)}</ul>
          <a href={product.href} target="_blank" rel="noopener noreferrer">{product.cta} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section id="praxec" class="family family-dark">
    <div class="shell family-layout">
      <header class="family-intro reveal">
        <p class="kicker">Open Source Ecosystem</p>
        <h2>Safe AI requires <em>deterministic</em> boundaries.</h2>
        <p>Praxec is a production-oriented foundation for putting deterministic boundaries around probabilistic models—so teams can use AI while retaining control over state, tools, approvals, and evidence.</p>
        <a class="text-link" href="https://github.com/praxec" target="_blank" rel="noopener noreferrer">Explore the Praxec organization ↗</a>
      </header>
      <div class="family-modules">
        <article><span>01</span><h3>Execution kernel</h3><p>Legal workflow transitions and authoritative gates live in code, not in model interpretation.</p></article>
        <article><span>02</span><h3>Cognitive architectures</h3><p>Structured, governed approaches for discovery, analysis, FMECA, implementation, and verification.</p></article>
        <article><span>03</span><h3>Deterministic MCP tools</h3><p>CPM planning, elicitation, scientific process, cross-matrix analysis, corpus work, and operational utilities.</p></article>
        <article><span>04</span><h3>FrontRails</h3><p>A Praxec capability pack for governed product and engineering work, including IntentOS and StructureOS.</p></article>
      </div>
    </div>
  </section>

  <section id="tflo" class="family family-light dossier-grid">
    <div class="shell family-layout">
      <header class="family-intro reveal">
        <p class="kicker">Family Study: Temporal Runtimes</p>
        <h2>Event-processing for <em>distributed</em> systems.</h2>
        <p>The tflo family explores embeddable temporal event processing across Rust, WASM, React, and browser environments—with shared models and deterministic behavior as design goals.</p>
        <a class="text-link" href="https://github.com/matt-cochran?tab=repositories&q=tflo" target="_blank" rel="noopener noreferrer">Explore tflo repositories ↗</a>
      </header>
      <div class="tflo-stack">
        <article><div><span>Runtime</span><h3>tflo-core</h3></div><p>The embeddable Rust engine and shared temporal foundation.</p></article>
        <article><div><span>Interface</span><h3>tflo-react</h3></div><p>Declarative temporal state for React applications backed by the shared runtime.</p></article>
        <article><div><span>Interaction</span><h3>tflo-browser-events</h3></div><p>Browser-event capture and signals designed around durable identifiers and pluggable sinks.</p></article>
      </div>
    </div>
  </section>

  <section id="proof" class="section shell" aria-labelledby="proof-title">
    <header class="section-heading reveal">
      <div><p class="kicker">Leadership / Attributed Evidence</p><h2 id="proof-title">Leadership &amp;<br />Attributed Proof</h2></div>
      <p>Breadth is useful when it becomes pattern recognition: across public companies, billion-dollar enterprise software, regulated domains, and early-stage teams.</p>
    </header>
    <div class="outcomes">
      {outcomes.map((outcome, index) => (
        <article class="outcome reveal" style={`--order:${index}`}>
          <p class="eyebrow">{outcome.eyebrow}</p><h3>{outcome.title}</h3><p>{outcome.copy}</p>
          {outcome.link && <a href={outcome.link} target="_blank" rel="noopener noreferrer">Read external case study ↗</a>}
        </article>
      ))}
    </div>
    <div class="proof-actions"><a class="button secondary" href="/resume/">View full résumé →</a><a class="text-link" href="/about/">More about Matthew →</a></div>
  </section>

  <section id="method" class="methodology">
    <div class="method-grid" aria-hidden="true"></div>
    <div class="shell method-content reveal">
      <p class="kicker">Working method / 03</p>
      <h2>Conceive the product.<br />Steward the system.</h2>
      <p>Discovery, boundary analysis, critical-path planning, implementation, and verification form one accountable delivery loop. The artifacts change; the discipline does not.</p>
      <div class="method-steps">
        <span>Discover</span><i>→</i><span>Model risk</span><i>→</i><span>Plan the path</span><i>→</i><span>Ship</span><i>→</i><span>Verify</span>
      </div>
    </div>
  </section>

  <section id="engage" class="engagement shell reveal">
    <div><span class="status-stamp">Consultative Availability</span><h2>Startup Advisory for Technical Founders.</h2></div>
    <div><p>Focused help when architecture, product direction, AI integration, or delivery mechanics are becoming material company risks. The work is practical, bounded, and designed to leave the team stronger.</p><div class="engagement-links"><a class="button primary" href="/scale-readiness/">Explore startup help →</a><a class="text-link" href="mailto:matthew@cochranweb.com">Start a conversation</a></div></div>
  </section>
</BaseLayout>
