---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSignoff from '../../components/ArticleSignoff.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { render } from 'astro:content';
import { publishedPosts, postUrl } from '../../lib/posts';
export async function getStaticPaths() { return (await publishedPosts()).map(post => ({params:{slug:post.id.replace(/\.(md|mdx)$/,'')},props:{post}})); }
const {post}=Astro.props;
const {Content, headings}=await render(post);
const socialHero = post.data.heroImage?.endsWith('.svg') ? undefined : post.data.heroImage;
const noteFiles = import.meta.glob<{ Content: any }>('../../article-notes/*.md');
const loadNotes = noteFiles['../../article-notes/' + post.id + '.md'];
const Notes = loadNotes ? (await loadNotes()).Content : undefined;
const url=new URL(postUrl(post.id), Astro.site).href;
const schema={ '@context':'https://schema.org', '@type':'BlogPosting', headline:post.data.title,
  description:post.data.description ?? post.data.title, datePublished:post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? {dateModified:post.data.updatedDate.toISOString()} : {}),
  author:{'@type':'Person',name:'Matthew Cochran',url:new URL('/about/',Astro.site).href},
  mainEntityOfPage:url, url, image:new URL(socialHero ?? '/og-image.png',Astro.site).href,
  keywords:post.data.tags.join(', '), inLanguage:'en' };
---
<BaseLayout title={post.data.title + ' — Matthew Cochran'} description={post.data.description ?? post.data.title}
  image={socialHero} imageAlt={socialHero ? post.data.heroAlt : undefined} imageWidth={socialHero ? post.data.heroWidth : undefined} imageHeight={socialHero ? post.data.heroHeight : undefined} article>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')} />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    {post.data.updatedDate && <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />}
  </Fragment>
  <article class="article-page" data-pagefind-body>
    <header class="article-header"><div class="shell"><p class="kicker">Field note / {post.data.pubDate.getFullYear()}</p>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      {post.data.description && <p>{post.data.description}</p>}
      {post.data.heroImage && <img class="article-hero" src={post.data.heroImage} alt={post.data.heroAlt} aria-hidden={post.data.heroDecorative ? "true" : undefined} width={post.data.heroWidth} height={post.data.heroHeight} fetchpriority="high" decoding="async" />}
      <div><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time>
      <a href="/blog/">All writing →</a></div>
      {post.data.updatedDate && <p>Updated <time datetime={post.data.updatedDate.toISOString()}>{post.data.updatedDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></p>}
    </div></header>
    <div class="shell article-layout"><aside data-pagefind-ignore><span>Matthew Cochran</span><p>Product Architect</p>
      {headings.some(h=>h.depth===2) && <nav aria-label="Article contents"><details class="article-contents"><summary>On this page</summary><ul>{headings.filter(h=>h.depth===2).map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ul></details></nav>}
    </aside><div class="article-prose prose md:prose-lg"><Content /><ArticleSignoff />{Notes && <details class="article-technical-notes"><summary>Technical scope and implementation sources</summary><Notes /></details>}{post.data.heroImage && <img class="article-end-banner" src={post.data.heroImage} alt="" aria-hidden="true" data-pagefind-ignore width={post.data.heroWidth} height={post.data.heroHeight} loading="lazy" decoding="async" />}<NewsletterSignup /></div></div>
  </article>
</BaseLayout>
<style>.article-technical-notes{margin-top:1.75rem}.article-technical-notes summary{cursor:pointer}.article-end-banner{display:block;width:100%;height:auto;margin-block:3rem 0;border-radius:8px}.article-hero{width:100%;height:auto;border-radius:8px;margin-block:2rem}aside ul{padding-left:1rem}aside li{margin-block:.6rem}</style>
