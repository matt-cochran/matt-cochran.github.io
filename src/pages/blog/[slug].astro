---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const posts=await getCollection('blog');return posts.map(post=>({params:{slug:post.id.replace(/\.(md|mdx)$/,'')},props:{post}}));}
const { post }=Astro.props; const { Content }=await render(post);
---
<BaseLayout title={`${post.data.title} — Matthew Cochran`} description={post.data.description ?? post.data.title}>
  <article class="article-page">
    <header class="article-header dossier-grid"><div class="shell"><p class="kicker">Field note / {post.data.pubDate.getFullYear()}</p><h1>{post.data.title}</h1><div><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time><a href="/blog/">All writing →</a></div></div></header>
    <div class="shell article-layout"><aside><span>Matthew Cochran</span><p>Product builder, engineering leader, and governed-AI systems specialist.</p></aside><div class="article-prose"><Content /></div></div>
  </article>
</BaseLayout>
